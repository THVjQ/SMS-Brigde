# Copy to .env alongside docker-compose.truenas.yml and fill in. Every value below
# is validated by the compose file — a missing one stops the deploy instead of
# starting a server that quietly does the wrong thing.

# Full host path to a dataset on a REAL pool. Find your pool name with:
#   zpool list -o name
# then create the dataset (TrueNAS → Datasets → Add Dataset) and put its path here.
# Do NOT leave a placeholder: the container will not start without a real directory.
DATA_DIR=/mnt/CHANGE_ME/sms-bridge-data

# openssl rand -hex 32
API_KEY=

# Optional — leave empty to disable the admin HTTP endpoints entirely.
# Must differ from API_KEY. openssl rand -hex 32
ADMIN_KEY=
